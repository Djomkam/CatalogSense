{
  "settings": {
    "number_of_shards": "1",
    "number_of_replicas": "0",
    "analysis": {
      "analyzer": {
        "folding": {
          "type": "custom",
          "tokenizer": "standard",
          "filter": ["lowercase", "asciifolding"]
        }
      }
    }
  },
  "mappings": {
    "dynamic": "strict",
    "properties": {
      "catalogId": { "type": "keyword" },
      "sku":       { "type": "keyword" },
      "name": {
        "type": "text",
        "analyzer": "folding",
        "fields": { "keyword": { "type": "keyword", "ignore_above": 256 } }
      },
      "brand": {
        "type": "keyword",
        "fields": { "text": { "type": "text", "analyzer": "folding" } }
      },
      "category": {
        "type": "keyword",
        "fields": { "text": { "type": "text", "analyzer": "folding" } }
      },
      "colors": {
        "type": "keyword",
        "fields": { "text": { "type": "text", "analyzer": "folding" } }
      },
      "sizes":     { "type": "keyword" },
      "price":     { "type": "scaled_float", "scaling_factor": 100 },
      "currency":  { "type": "keyword" },
      "imageUrl":  { "type": "keyword", "index": false },
      "inStock":   { "type": "boolean" },
      "version":   { "type": "long" },
      "updatedAt": { "type": "date" }
    }
  }
}
